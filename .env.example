# ---------------------------------------------------------------------------
# NextPlace environment variables. Copy to .env.local for local development.
# Never commit real secrets. None of these are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# PostgreSQL connection. On Vercel + Supabase the integration's POSTGRES_URL /
# POSTGRES_URL_NON_POOLING are used automatically when DATABASE_URL is unset.
DATABASE_URL=postgresql://np:np@localhost:5432/nextplace
# 32+ random characters, e.g. `openssl rand -base64 48`. Required in production.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of the app (used for auth callbacks and reset links).
APP_URL=http://localhost:3000

# --- Private file storage ---------------------------------------------------
# "local" (development) or "supabase". Defaults to supabase when the URL and key are set.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=        # or SUPABASE_SECRET_KEY; server only
# SUPABASE_STORAGE_BUCKET=nextplace-private   # created automatically as a PRIVATE bucket

# --- Research providers (demo = synthetic, labeled, free) -------------------
MAPS_PROVIDER=demo            # demo | google | osm
CLIMATE_PROVIDER=demo         # demo | open-meteo
FACILITIES_PROVIDER=demo      # demo | google | overpass
# GOOGLE_MAPS_API_KEY=        # Places API (New) + Routes API enabled
# OSM_CONTACT_EMAIL=          # required by the Nominatim/Overpass usage policies

# --- AI assistant -----------------------------------------------------------
AI_PROVIDER=off               # off (chat shows "coming soon") | demo (rule-based, labeled) | anthropic | openai | gemini | openrouter | grok | groq
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- OCR for scanned PDFs (off by default) ---------------------------------
OCR_PROVIDER=off              # off | google-vision | ocr-space
# GOOGLE_VISION_API_KEY=
# OCR_SPACE_API_KEY=

# --- Email (password reset) ---------------------------------------------------
EMAIL_PROVIDER=outbox         # outbox (stored in DB, visible to admins) | resend
# RESEND_API_KEY=
# EMAIL_FROM="NextPlace <no-reply@your-domain>"

# --- Background worker ------------------------------------------------------
# Secret for GET /api/cron/worker (Vercel Cron sends it automatically as a Bearer token).
# CRON_SECRET=

# OpenAI (used when AI_PROVIDER=openai, or automatically when OPENAI_API_KEY is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google Gemini (AI_PROVIDER=gemini, or automatically when GEMINI_API_KEY is set and no OpenAI key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (one key, many models). Comma list = tried in order. If the chosen provider fails,
# the bot automatically tries every other provider that has a key.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/auto

# xAI Grok (backup; no web search)
XAI_API_KEY=
GROK_MODEL=grok-4

# Groq (fast, free tier; backup; no web search)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
