# Default uses a durable embedded PostgreSQL (PGlite) under .data/.
# Use PostgreSQL for hosted operation; Supabase connection string works here.
# DATABASE_URL=postgresql://user:password@localhost:5432/transfer_compass
DATA_DIR=.data
PORT=3000
# GOOGLE_MAPS_KEY=
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OCR_ENDPOINT=https://your-ocr-gateway.example/extract-pdf
# OCR_KEY=
# EMAIL_ENDPOINT=https://your-email-gateway.example/send
# EMAIL_KEY=
# Optional concrete integrations (server-side only)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=transfer-compass-private
# RESEND_API_KEY=
# EMAIL_FROM=Transfer Compass <no-reply@your-verified-domain.example>
# OCR_SPACE_KEY=

# Optional authenticated external scheduler for Vercel background processing
# CRON_SECRET=
# Never expose database credentials or service-role keys through VITE_ variables.
